# Local configuration for chora-oe-grading.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=dev

# Event bus — NATS JetStream (dispatch subscriber). The subscriber refuses to
# start without it (AGENT_DISPATCH_ENABLED=true + NATS_URL).
NATS_URL=nats://nats:4222
AGENT_DISPATCH_ENABLED=true
AGENT_HEALTH_PORT=8080

# Model gateway. CHORA_GATEWAY_INSECURE=1 selects plaintext gRPC to a local
# gateway (dev only); otherwise CHORA_GATEWAY_TOKEN is required.
CHORA_GATEWAY_ENDPOINT=localhost:9090
CHORA_GATEWAY_INSECURE=1
CHORA_GATEWAY_TOKEN=
CHORA_GATEWAY_TENANT_ID=tenant-local
CHORA_GATEWAY_GCID=0192f4c1-aaaa-bbbb-cccc-ddddeeeeffff
CHORA_GATEWAY_AUDIENCE=https://gateway.chora.site

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
CHORA_SERVICE_VERSION=dev
